{
  "name": "@xauconnect/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate --schema ../prisma/schema.prisma && tsc --noEmit",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "indexer": "tsx src/indexer/worker.ts"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@xauconnect/utils": "workspace:*",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "viem": "^2.21.57",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
