# ==============================================================================
# XAUConnect — environment template
#
# Copy to .env and fill in real values. Never commit the filled file.
# Verify: https://xauconnect.com/api/health
#
# API KEYS — where to get them:
#   RPC (required for live swap quotes + on-chain reads):
#     • Alchemy  https://dashboard.alchemy.com  → create app per chain → HTTPS URL
#     • Infura   https://infura.io              → project ID → RPC URL
#     Set RPC_ETHEREUM, RPC_BSC, RPC_POLYGON, etc. (one per chain you support).
#
#   Swap aggregators (at least ONE required; both recommended):
#     • 1inch    https://business.1inch.com  → ONEINCH_API_KEY
#     • 0x       https://0x.org/docs           → ZEROX_API_KEY (Swap API)
#     • Paraswap https://developers.paraswap.network → PARASWAP_API_KEY (optional)
#     • Jupiter  keyless lite tier; JUPITER_API_KEY optional for Solana pro
#
#   1inch host (optional — both .com and .dev work with the same API key):
#     ONEINCH_API_BASE=https://api.1inch.com   # default (1inch Business)
#     ONEINCH_API_BASE=https://api.1inch.dev   # legacy portal through 2026-01-31
#     See docs/SWAP_EXECUTION.md for quote vs build vs on-chain execution.
#
#   Discovery / launches (NO key needed):
#     • DexScreener — used automatically for trending, new launches, token detail
#
#   Wallet history (optional — returns empty until configured):
#     • Alchemy/Covalent/Helius indexer APIs
#
#   WalletConnect (web app — apps/web/.env.production on server):
#     • https://cloud.walletconnect.com → NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
#
# ON-CHAIN EXECUTION (optional — quotes work without this):
#   Deploy AggregatorRouter (packages/contracts) then set per chain:
#     ROUTER_ADDRESS_ETHEREUM=0x...
#     ROUTER_ADDRESS_BSC=0x...
# ==============================================================================

# ------------------------------------------------------------------------------
# Core infrastructure (REQUIRED in production)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://xau:xau@localhost:5432/xauconnect?schema=public"
REDIS_URL=""
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
# Credentials for the admin console. Set both. Do not leave the defaults.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"
# Comma-separated wallet addresses granted the ADMIN role on sign-in
ADMIN_ADDRESSES="0x0000000000000000000000000000000000000000"
CORS_ORIGINS="https://xauconnect.com"

# ------------------------------------------------------------------------------
# Protocol fees (basis points: 100 = 1%, 10_000 = 100%)
# Per-chain overrides live in PostgreSQL via /admin dashboard.
# ------------------------------------------------------------------------------
PROTOCOL_FEE_BPS_DEFAULT=30
JUPITER_PLATFORM_FEE_BPS=500
EVM_INTEGRATOR_FEE_BPS=300
PROTOCOL_FEE_BPS_MIN=0
PROTOCOL_FEE_BPS_MAX=10000
LP_FEE_BPS=10
LAUNCHPAD_CURVE_FEE_BPS=100
# On-chain FeeCollector proxy per chain (set after deploy) — fees accrue here first
FEE_RECIPIENT="0x0000000000000000000000000000000000000000"
# Hot wallet that receives FeeCollector withdrawals (same on all 6 EVM chains)
PROTOCOL_FEE_COLLECTOR_EVM="0xC0624F22BAd798Bd9236EF0c95E35404614079B6"
PROTOCOL_TREASURY_EVM="0x2fb7e1544Ab930593d102a928737556cf787ef27"
PROTOCOL_OPERATIONS_EVM="0x6b16cD6c922F5FA47D27a0cE0d86434597e94b69"
# Solana integrator fee destination (Jupiter platformFeeBps / feeAccount)
SOLANA_FEE_WALLET="ENobDuF4iGAmF1Y211aLj6gXCNpdHBfnNkUyLDdbUabb"
# bs58 secret for fee wallet — creates Jupiter fee ATAs and Gold Curve configs (never commit)
SOLANA_FEE_COLLECTOR_KEY=
# Meteora DBC partner configs (public keys). Created once by backend/scripts/create-dbc-configs.ts
DBC_CONFIG_FAIR_SOL=
DBC_CONFIG_FAIR_USDC=
DBC_CONFIG_SHIELD_SOL=
DBC_CONFIG_SHIELD_USDC=
DBC_CONFIG_DISTRIBUTE_SOL=
DBC_CONFIG_DISTRIBUTE_USDC=

# ------------------------------------------------------------------------------
# EVM RPC endpoints (REQUIRED — use Alchemy/Infura, not public endpoints)
# ------------------------------------------------------------------------------
RPC_ETHEREUM="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_BSC="https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_POLYGON="https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_ARBITRUM="https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_BASE="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_AVALANCHE="https://avax-mainnet.g.alchemy.com/v2/YOUR_KEY"
RPC_SOLANA="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
# Same Helius key — Enhanced Transactions API (Solana indexer + wallet history)
HELIUS_API_KEY=""

# ------------------------------------------------------------------------------
# Aggregator API keys (REQUIRED for live swap quotes — no demo fallback)
# 1inch returns quotes + unsigned calldata only — wallets broadcast EVM txs.
# See docs/SWAP_EXECUTION.md
# ------------------------------------------------------------------------------
ONEINCH_API_KEY=""
# 1inch Business API host (default https://api.1inch.com; legacy https://api.1inch.dev)
ONEINCH_API_BASE="https://api.1inch.com"
ZEROX_API_KEY=""
PARASWAP_API_KEY=""
JUPITER_API_KEY=""
COINGECKO_API_KEY=""
BIRDEYE_API_KEY=""

# ------------------------------------------------------------------------------
# On-chain router addresses (set after contract deploy)
# ------------------------------------------------------------------------------
ROUTER_ADDRESS_ETHEREUM=""
ROUTER_ADDRESS_BSC=""
ROUTER_ADDRESS_POLYGON=""
ROUTER_ADDRESS_ARBITRUM=""
ROUTER_ADDRESS_BASE=""
ROUTER_ADDRESS_AVALANCHE=""

# On-chain FeeCollector proxy per chain (vault where router swap fees accrue)
FEE_COLLECTOR_ADDRESS_ETHEREUM=""
FEE_COLLECTOR_ADDRESS_BSC=""
FEE_COLLECTOR_ADDRESS_POLYGON=""
FEE_COLLECTOR_ADDRESS_ARBITRUM=""
FEE_COLLECTOR_ADDRESS_BASE=""
FEE_COLLECTOR_ADDRESS_AVALANCHE=""

# ------------------------------------------------------------------------------
# Indexer worker (optional separate host)
# ------------------------------------------------------------------------------
INDEXER_ENABLED=false
INDEXER_ROLE=none
INDEXER_HEALTH_PORT=4100
MARKET_SOURCE=hybrid
HELIUS_API_KEY=""

# ------------------------------------------------------------------------------
# Fiat on-ramp / off-ramp (Buy & Sell crypto)
# Setup guide: docs/FIAT_ONRAMP_SETUP.md
# Leave all blank to keep Buy/Sell in "coming soon" mode (feature is gated).
# Provider selection: "auto" uses the first configured provider in priority
# order (Transak → Onramper). Force one with "transak" or "onramper".
# ------------------------------------------------------------------------------
ONRAMP_PROVIDER="auto"

# ── Transak (recommended) — instant STAGING key, Merchant of Record ──
# Sign up at dashboard.transak.com → Developers → API Keys. Staging key is
# issued immediately (no KYB); production key unlocks after one-time KYB.
TRANSAK_API_KEY=""
TRANSAK_API_SECRET=""
TRANSAK_ENVIRONMENT="staging"   # "staging" | "production"

# ── Onramper aggregator (optional fallback) ──
ONRAMPER_API_KEY=""
ONRAMPER_PUBLISHABLE_KEY=""
ONRAMPER_WEBHOOK_SECRET=""
ONRAMPER_API_BASE="https://api.onramper.com"
ONRAMPER_WIDGET_HOST="https://buy.onramper.com"

# ------------------------------------------------------------------------------
# IPFS (launchpad metadata / logos)
# ------------------------------------------------------------------------------
WEB3_STORAGE_TOKEN=""

# ------------------------------------------------------------------------------
# Contract deployment (local only — NEVER commit real keys)
# ------------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=""
# Signs FeeCollector.setSwapFeeBps when admin saves fees (needs FEE_MANAGER on contract)
FEE_MANAGER_PRIVATE_KEY=""
ETHERSCAN_API_KEY=""
BSCSCAN_API_KEY=""

# ------------------------------------------------------------------------------
# Web app build-time vars.
# Leave API/WS unset. The browser uses same-origin /api and /ws.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_APP_URL="https://xauconnect.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-4PW0NYEQ91"
# Google Search Console HTML tag verification (optional, build-time)
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools HTML tag verification (optional, build-time)
BING_SITE_VERIFICATION=""
