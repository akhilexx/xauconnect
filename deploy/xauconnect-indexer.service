[Unit]
Description=XAUConnect chain indexer worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/xauconnect/backend
EnvironmentFile=/opt/xauconnect/.env
Environment=INDEXER_ENABLED=true
Environment=INDEXER_ROLE=worker
ExecStart=/usr/bin/npx tsx src/indexer/worker.ts
Restart=always
RestartSec=10
StandardOutput=append:/opt/xauconnect/logs/indexer.log
StandardError=append:/opt/xauconnect/logs/indexer.err.log

[Install]
WantedBy=multi-user.target
